# ==============================================================================
# Sentinel Project Root .gitignore
# ==============================================================================

# 1. 外部 SDK / 固件包 / 离线压缩包 (ST SDK & Large Archives)
# ------------------------------------------------------------------------------
STM32Cube_FW_F4_*/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# 2. 编译与构建产物 (Build Artifacts & Binaries)
# ------------------------------------------------------------------------------
**/build/
**/out/
**/.cache/
*.o
*.obj
*.o.d
*.obj.d
*.d
*.elf
*.hex
*.bin
*.axf
*.map
*.a
*.lib
*.so
*.dll
*.dylib
*.exe
ninja.log
.ninja_*
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CompileCommands.json

# 3. Python 虚拟环境与打包产物 (Python venvs, bytecode, packaging)
# ------------------------------------------------------------------------------
# Match both environment directories and compatibility symlinks.
**/.venv
**/venv/
**/env/
**/__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/
.coverage
htmlcov/
dist/
**/_internal/
HANDOFF-*/app/

# 4. 临时文件与离线抓包/标定原始大文件 (Temp logs, dumps & raw datasets)
# ------------------------------------------------------------------------------
**/.tmp/
**/tmp/
*.log
*.sraw
*.sraw.summary.json
*.wire.jsonl
**/records/
Plan.local.md

# 5. 本地参考资料与旧工程镜像 (References & Manuals)
# 遵循 Hushi_EC_2026_Refactor 约定：手册与旧工程不入库
**/references/
**/docs/boards/sentinel_f407/references/

# 6. 编辑器与 IDE 配置 (IDEs & Editors)
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
.clion/
*.swp
*.swo
*~
.DS_Store
.obsidian/

# 7. 嵌入式开发工具与工程私有产物 (Embedded IDEs: Keil, IAR, CubeMX)
# ------------------------------------------------------------------------------
# Keil MDK
*.uvopt
*.uvoptx
*.uvguix.*
*.bak
*.dep
JLinkLog.txt

# IAR EWARM
*.ewd
settings/

# STM32CubeMX 本机生成配置与独立构建入口（避免覆盖根工程）
**/.mxproject
**/boards/sentinel_f407/cubemx/sentinel_s1/CMakeLists.txt
**/boards/sentinel_f407/cubemx/sentinel_s1/CMakePresets.json
**/boards/sentinel_f407/cubemx/sentinel_s1/cmake/

# 8. 快照与外部仓库 (Snapshots & external repos)
# ------------------------------------------------------------------------------
/sentinel-src-*/
/视觉/
/archives/

# 9. 工具缓存与遗漏构建目录 (Tool cache & missed build dirs)
# ------------------------------------------------------------------------------
/.playwright-mcp/
**/build-host-guardian/

# 10. 交接包运行产物 (Handoff runtime outputs)
# ------------------------------------------------------------------------------
# 2026-11-12 修订: 原规则 HANDOFF-*/results/ 与 HANDOFF-*/deliverables/ 按整个目录排除,
# 而 git 对已排除目录内部的 ! 取反无效, 导致 results/ 下 37 份结论文档与全部小 json
# (FINAL.md、各 REPORT.md、analysis/trial/summary.json) 物理上无法入库。
# 现改为按扩展名排除原始采集, 放行 .md/.json/.txt/.sha256 等结论载体。
HANDOFF-*/results/**/*.csv
HANDOFF-*/results/**/*.jsonl
HANDOFF-*/results/**/*.mp4
HANDOFF-*/results/**/*.sraw
HANDOFF-*/results/**/*.wire
HANDOFF-*/results/**/*.jpg
HANDOFF-*/results/media/
# deliverables/ 是被阻塞的交付快照, 其中 source/ 的 398 个文件有 307~343 个与
# 同包 source/ 逐字节重复, 因此只保留各快照的 README.md 说明。
HANDOFF-*/deliverables/**/source/
HANDOFF-*/deliverables/**/firmware/
HANDOFF-*/deliverables/**/native*/
HANDOFF-*/deliverables/**/native-linux/
HANDOFF-*/deliverables/**/logs/
HANDOFF-*/deliverables/**/demos/
HANDOFF-*/deliverables/**/verification/
# 第 10 个交接包位于 test/ 下, 上面的 HANDOFF-* 前缀规则不会匹配它。
test/HANDOFF-*/records/
test/HANDOFF-*/build/

# 11. 大体积参考资料 (Large references)
# ------------------------------------------------------------------------------
docs/robomaster_official_rules/**/*.pdf
/参数/*.jpg

# 12. 临时备份 (Temp backups)
# ------------------------------------------------------------------------------
*.bak-*
*.orig

# 13. 交接包证据日志保留 (Keep handoff evidence logs)
# ------------------------------------------------------------------------------
!HANDOFF-*/evidence/**/*.log
!HANDOFF-*/**/evidence/**/*.log
