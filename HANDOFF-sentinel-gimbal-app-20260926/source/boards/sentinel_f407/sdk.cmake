if(NOT CMAKE_CROSSCOMPILING OR NOT CMAKE_SYSTEM_PROCESSOR STREQUAL "arm")
    message(FATAL_ERROR "S1 requires the Arm cross toolchain")
endif()
set(EC_STM32CUBE_F4_ROOT "" CACHE PATH "Installed STM32CubeF4 1.28.3 package")
if(NOT EXISTS "${EC_STM32CUBE_F4_ROOT}/package.xml")
    message(FATAL_ERROR "Set EC_STM32CUBE_F4_ROOT to the complete 1.28.3 package")
endif()
# 检查包身份; 这不是对整个 SDK 所有文件的完整性证明.
file(SHA256 "${EC_STM32CUBE_F4_ROOT}/package.xml" _package_hash)
if(NOT _package_hash STREQUAL "2ca0b2176def28e82823a90254da021ca0de0e42e3bac6822a3c02480bde36d4")
    message(FATAL_ERROR "Unexpected CubeF4 package metadata; verify SDK provenance before updating the pin")
endif()
set(EC_CUBE_PROJECT "${EC_STM32CUBE_F4_ROOT}")
set(EC_BOARD_CONFIG_DIR "${CMAKE_CURRENT_LIST_DIR}/cubemx/sentinel_s1/Core/Inc")
